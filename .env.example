GOOGLE_CLOUD_PROJECT=ia-sentire-customs-broker
FIRESTORE_DATABASE=mrapi-dev
EVIDENCE_BUCKET=mrapi-dev-evidence
DEFAULT_TENANT_ID=tenant_facundo_group
NODE_ENV=production
PORT=8080
BOOTSTRAP_ON_START=true

# Runner API protection. Use a long random value in Cloud Run and Shadow.
RUNNER_SHARED_SECRET=change-me

# Shadow Runner local configuration
MRAPI_BASE_URL=https://YOUR-CLOUD-RUN-URL
MRAPI_TENANT_ID=tenant_facundo_group
MRAPI_EXECUTOR_ID=executor_shadow_codex_01
MRAPI_HOST_NAME=Shadow
MRAPI_EXECUTOR_NAME=Codex
MRAPI_RUNNER_SECRET=change-me
MRAPI_WORKER_IDS=W01
MRAPI_POLL_SECONDS=10
